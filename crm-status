#!/usr/bin/env bash
set -euo pipefail

STATE_DIR=".crm"

check_process() {
  local name="$1"
  local pid_file="$2"

  if [ ! -f "$pid_file" ]; then
    echo "$name: non géré / non démarré"
    return
  fi

  local pid
  pid="$(cat "$pid_file")"

  if kill -0 "$pid" 2>/dev/null; then
    echo "$name: actif (PID $pid)"
  else
    echo "$name: PID file présent mais processus arrêté (PID $pid)"
  fi
}

check_process "front" "$STATE_DIR/front.pid"
check_process "server" "$STATE_DIR/server.pid"
check_process "worker" "$STATE_DIR/worker.pid"
check_process "redis" "$STATE_DIR/redis.pid"

echo "--- Ports ---"
lsof -nP -iTCP:3000 -sTCP:LISTEN 2>/dev/null | grep -v WARNING || true
lsof -nP -iTCP:3001 -sTCP:LISTEN 2>/dev/null | grep -v WARNING || true

